# Copy to `.env` in the project root and fill in the values you need.
# `storybook_project/settings.py` loads this file automatically via python-dotenv.

# --- Django ---
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
# DATABASE_PATH=/absolute/path/to/db.sqlite3

# --- Text generation (story outline + page text) ---
# TEXT_PROVIDER=mock (default, no network/API key needed) | openrouter
TEXT_PROVIDER=mock

# Used when TEXT_PROVIDER=openrouter. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default model: Kimi K2 (moonshotai/kimi-k2) -- our first hunch for creative,
# child-friendly short stories. Swap this to A/B test other models without
# code changes, e.g.:
#   anthropic/claude-3.5-sonnet
#   openai/gpt-4o-mini
#   google/gemini-2.0-flash-001
OPENROUTER_MODEL=moonshotai/kimi-k2
OPENROUTER_TEMPERATURE=0.9
# Optional, only used for OpenRouter's leaderboard attribution:
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# --- Image generation (page illustrations) ---
# IMAGE_PROVIDER=mock (default, no network/API key needed) | fal
IMAGE_PROVIDER=mock

# Used when IMAGE_PROVIDER=fal. Get a key at https://fal.ai/dashboard/keys
FAL_KEY=
# Default model: fal-ai/flux/schnell -- extremely fast (~0.76s) and cheap
# (~$0.003/megapixel image), great for local testing/iteration.
# For production, swap FAL_MODEL to:
#   bytedance/seedream/v5/pro/text-to-image  (Seedream 5.0 Pro: cheap, doesn't
#     worry about copyrighted IPs)
#   fal-ai/nano-banana-pro                   (Google Nano Banana Pro: highest
#     quality, most expensive)
FAL_MODEL=fal-ai/flux/schnell
