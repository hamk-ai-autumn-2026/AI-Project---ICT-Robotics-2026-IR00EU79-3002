# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (frontend dev server, deployed frontend URL)
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL via Prisma) ---
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL=

# --- Auth ---
# Secret used to sign/verify JWTs if using simple email/password auth instead of Supabase Auth.
JWT_SECRET=
# If using Supabase Auth instead, set these and verify Supabase-issued JWTs on the backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI: Anthropic Claude (story/text generation) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# --- AI: Image generation (choose ONE provider and set its key) ---
# OpenAI Images API
OPENAI_API_KEY=
# Stability AI
STABILITY_API_KEY=
IMAGE_PROVIDER=openai

# --- Storage (choose ONE) ---
# Supabase Storage
SUPABASE_STORAGE_BUCKET=storybook-assets
# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
